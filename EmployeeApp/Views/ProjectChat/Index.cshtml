@{
    ViewData["Title"] = "Project Management AI Chatbot";
}

<div class="container mt-4" style="max-width: 750px;">
    <h3 class="mb-3">Project Management Assistant</h3>
    
    <!-- Changed bg-light to bg-body-tertiary for dynamic dark/light theme background -->
    <div id="chatBox" class="border rounded p-3 mb-3 bg-body-tertiary" style="height: 400px; overflow-y: auto;">
        <!-- Changed bg-white to bg-body-secondary -->
        <div class="p-2 mb-2 bg-body-secondary rounded shadow-sm" style="max-width: 75%;">
            <strong>Bot:</strong> Hello! Ask me anything about your project schedules, tasks, or resource planning.
        </div>
    </div>

    <div class="input-group">
        <input type="text" id="userMsg" class="form-control" placeholder="Type your message..." onkeypress="if(event.key==='Enter') sendChat()" />
        <button class="btn btn-primary" onclick="sendChat()">Send</button>
    </div>
</div>

<script>
    const sessionId = "session_" + Math.random().toString(36).substring(2, 9);

    async function sendChat() {
        const input = document.getElementById("userMsg");
        const msg = input.value.trim();
        if (!msg) return;

        const chatBox = document.getElementById("chatBox");

        // Display user query
        chatBox.innerHTML += `<div class="text-end p-2 mb-2 bg-primary text-white rounded ms-auto" style="max-width: 75%;"><strong>You:</strong> ${escapeHtml(msg)}</div>`;
        input.value = "";
        chatBox.scrollTop = chatBox.scrollHeight;

        // Display thinking placeholder using bg-body-secondary
        const tempId = "loading_" + Date.now();
        chatBox.innerHTML += `<div id="${tempId}" class="p-2 mb-2 bg-body-secondary rounded shadow-sm" style="max-width: 75%;"><em>Thinking...</em></div>`;

        try {
            const res = await fetch('/ProjectChat/SendMessage', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ sessionId: sessionId, message: msg })
            });
            const data = await res.json();
            document.getElementById(tempId).remove();

            if (data.success) {
                // Dynamically injected bot message using theme-aware bg-body-secondary
                chatBox.innerHTML += `<div class="p-2 mb-2 bg-body-secondary rounded shadow-sm" style="max-width: 75%;"><strong>Bot:</strong> <pre style="white-space: pre-wrap; margin:0; font-family: inherit; color: inherit;">${escapeHtml(data.output)}</pre></div>`;
            } else {
                chatBox.innerHTML += `<div class="p-2 mb-2 bg-danger text-white rounded" style="max-width: 75%;"><strong>Error:</strong> ${escapeHtml(data.errorMessage)}</div>`;
            }
        } catch {
            document.getElementById(tempId).remove();
            chatBox.innerHTML += `<div class="text-danger p-2">Connection failed.</div>`;
        }
        chatBox.scrollTop = chatBox.scrollHeight;
    }

    function escapeHtml(str) {
        return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
    }
</script>