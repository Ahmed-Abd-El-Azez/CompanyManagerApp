@model EmployeeApp.Models.ViewModels.DepartmentViewModel

@{
    ViewData["Title"] = "Department Details";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">
            <div class="card shadow-sm border rounded-3">
                <!-- Changed bg-dark to bg-body-tertiary with bottom border for adaptive theme support -->
                <div class="card-header bg-body-tertiary text-body p-3 d-flex align-items-center justify-content-between border-bottom">
                    <h4 class="card-title mb-0 fs-5 fw-bold">
                        <i class="bi bi-building me-2"></i>Department Details
                    </h4>
                    <!-- Updated badge to theme-aware surface classes -->
                    <span class="badge bg-body-secondary text-body border fs-6">ID: #@Model.DepartmentId</span>
                </div>

                <div class="card-body p-4">
                    <dl class="row mb-0 fs-6 gy-3">
                        <!-- Department Name -->
                        <dt class="col-sm-4 text-muted">@Html.DisplayNameFor(model => model.DepartmentName)</dt>
                        <!-- Changed text-dark to text-body -->
                        <dd class="col-sm-8 fw-bold fs-5 text-body mb-0">@Model.DepartmentName</dd>

                        <!-- Location -->
                        <dt class="col-sm-4 text-muted">@Html.DisplayNameFor(model => model.Location)</dt>
                        <dd class="col-sm-8 mb-0">
                            <i class="bi bi-geo-alt-fill text-danger me-1"></i>@Model.Location
                        </dd>

                        <!-- Assigned Employees Count -->
                        <dt class="col-sm-4 text-muted">Assigned Employees</dt>
                        <dd class="col-sm-8 mb-0">
                            @if (Model.EmployeeCount > 0)
                            {
                                <!-- Updated badge to subtle secondary styling for better dark mode readability -->
                                <span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle px-3 py-2 fw-normal">
                                    <i class="bi bi-people me-1"></i>@Model.EmployeeCount Employee(s) Assigned
                                </span>
                            }
                            else
                            {
                                <span class="text-muted fst-italic">No Employees Assigned</span>
                            }
                        </dd>
                    </dl>

                    <hr class="my-4" />

                    <!-- Action Buttons -->
                    <div class="d-flex align-items-center justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary px-3">
                            <i class="bi bi-arrow-left me-1"></i>Back to List
                        </a>
                        <a asp-action="Edit" asp-route-id="@Model.DepartmentId" class="btn btn-warning px-4 fw-semibold">
                            <i class="bi bi-pencil-square me-1"></i>Edit Department
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>