@model EmployeeApp.Models.ViewModels.ProjectViewModel


@{
    ViewData["Title"] = "Delete Project";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card shadow-sm border-danger border-opacity-25 rounded-3">
                <div class="card-header bg-danger text-white p-3">
                    <h4 class="card-title mb-0 fs-5 fw-bold">
                        <i class="bi bi-folder-x me-2"></i>Delete Project
                    </h4>
                </div>

                <div class="card-body p-4">
                    <div class="alert alert-warning d-flex align-items-center mb-4" role="alert">
                        <i class="bi bi-exclamation-triangle-fill fs-4 me-2"></i>
                        <div>
                            Are you sure you want to delete this project? This action cannot be undone.
                        </div>
                    </div>

                    <dl class="row mb-0 fs-6 gy-3">
                        <!-- Project Name -->
                        <dt class="col-sm-4 text-muted">@Html.DisplayNameFor(model => model.ProjectName)</dt>
                        <dd class="col-sm-8 fw-bold text-dark mb-0">@Html.DisplayFor(model => model.ProjectName)</dd>

                        <!-- Start Date -->
                        <dt class="col-sm-4 text-muted">@Html.DisplayNameFor(model => model.StartDate)</dt>
                        <dd class="col-sm-8 mb-0">
                            @Model.StartDate.ToString("MMM dd, yyyy")
                        </dd>

                        <!-- Budget -->
                        <dt class="col-sm-4 text-muted">@Html.DisplayNameFor(model => model.Budget)</dt>
                        <dd class="col-sm-8 fw-semibold text-success mb-0">
                            @Model.Budget.ToString("C")
                        </dd>
                    </dl>

                    <hr class="my-4" />

                    <!-- Form Submission -->
                    <form asp-action="Delete" method="post">
                        <input type="hidden" asp-for="ProjectId" />

                        <div class="d-flex align-items-center justify-content-between">
                            <a asp-action="Index" class="btn btn-outline-secondary px-3">
                                <i class="bi bi-arrow-left me-1"></i>Cancel
                            </a>
                            <button type="submit" class="btn btn-danger px-4 fw-semibold">
                                <i class="bi bi-trash-fill me-1"></i>Confirm Delete
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>