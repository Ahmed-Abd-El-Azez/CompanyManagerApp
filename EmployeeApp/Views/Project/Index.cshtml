@model IEnumerable<EmployeeApp.Models.ViewModels.ProjectViewModel>

@{
    ViewData["Title"] = "Projects";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h2 mb-0">Projects</h1>
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle me-1"></i>Create New
            </a>
        }
    </div>

    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>
                                @Html.DisplayNameFor(model => model.ProjectName)
                            </th>
                            <th>
                                Employees
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.StartDate)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.Budget)
                            </th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="fw-semibold">
                                        @Html.DisplayFor(modelItem => item.ProjectName)
                                    </td>
                                    <td>
                                        @if (item.EmployeesCount > 0)
                                        {
                                            <span class="badge bg-secondary">@item.EmployeesCount Employee(s)</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted fs-7">0</span>
                                        }
                                    </td>
                                    <td>
                                        <i class="bi bi-calendar-event text-primary me-1"></i>@item.StartDate.ToString("MMM dd, yyyy")
                                    </td>
                                    <td class="fw-semibold text-success">
                                        @item.Budget.ToString("C")
                                    </td>
                                    <td class="text-end pe-4">
                                        @if (User.IsInRole("Admin"))
                                        {
                                            <a asp-action="Edit" asp-route-id="@item.ProjectId" class="btn btn-sm btn-outline-warning me-1">
                                                <i class="bi bi-pencil"></i> Edit
                                            </a>
                                        }

                                        <a asp-action="Details" asp-route-id="@item.ProjectId" class="btn btn-sm btn-outline-info me-1">
                                            <i class="bi bi-info-circle"></i> Details
                                        </a>

                                        @if (User.IsInRole("Admin"))
                                        {
                                            <a asp-action="Delete" asp-route-id="@item.ProjectId" class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-trash"></i> Delete
                                            </a>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted">
                                    No projects found.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>