@model EmployeeApp.Models.ViewModels.RegisterVm

@{
    ViewData["Title"] = "Register";
}

<div class="d-flex align-items-center justify-content-center min-vh-80 py-5">
    <div class="card border-0 p-4 p-sm-5 apple-card" style="width: 100%; max-width: 440px;">
        <!-- Header -->
        <div class="text-center mb-4">
            <div class="d-inline-flex align-items-center justify-content-center bg-primary-subtle text-primary rounded-circle mb-3" style="width: 52px; height: 52px;">
                <i class="bi bi-person-plus-fill fs-4"></i>
            </div>
            <h2 class="fw-bold tracking-tight text-body mb-1">Create Account</h2>
            <p class="text-body-secondary small">Enter your information to register</p>
        </div>

        <form asp-controller="Account" asp-action="Register" method="post">
            <!-- Validation Summary -->
            <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 rounded-3 small py-2 px-3 mb-3"></div>

            <!-- Email Field -->
            <div class="mb-3">
                <label asp-for="Email" class="form-label fw-medium text-body-secondary small"></label>
                <div class="input-group">
                    <span class="input-group-text border-end-0 text-body-secondary rounded-start-3"><i class="bi bi-envelope"></i></span>
                    <input asp-for="Email" class="form-control border-start-0 rounded-end-3 py-2 px-3" placeholder="name@example.com" />
                </div>
                <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
            </div>

            <!-- Password Field -->
            <div class="mb-3">
                <label asp-for="Password" class="form-label fw-medium text-body-secondary small"></label>
                <div class="input-group">
                    <span class="input-group-text border-end-0 text-body-secondary rounded-start-3"><i class="bi bi-lock"></i></span>
                    <input asp-for="Password" class="form-control border-start-0 rounded-end-3 py-2 px-3" type="password" placeholder="••••••••" />
                </div>
                <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
            </div>

            <!-- Confirm Password Field -->
            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="form-label fw-medium text-body-secondary small"></label>
                <div class="input-group">
                    <span class="input-group-text border-end-0 text-body-secondary rounded-start-3"><i class="bi bi-shield-lock"></i></span>
                    <input asp-for="ConfirmPassword" class="form-control border-start-0 rounded-end-3 py-2 px-3" type="password" placeholder="••••••••" />
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-danger small mt-1 d-block"></span>
            </div>

            <!-- Submit Button -->
            <button type="submit" class="btn btn-primary w-100 py-2.5 fw-semibold apple-btn">
                Register
            </button>
        </form>

        <!-- Footer Link -->
        <div class="text-center mt-4 pt-3 border-top border-body-secondary">
            <p class="text-body-secondary small mb-0">
                Already have an account?
                <a asp-controller="Account" asp-action="Login" class="text-primary fw-semibold text-decoration-none">Log in</a>
            </p>
        </div>
    </div>
</div>

<style>
    :root {
        --card-bg: #ffffff;
        --input-bg: #f5f5f7;
        --input-border: #e5e5ea;
        --input-focus-bg: #ffffff;
        --card-shadow: 0 20px 40px rgba(0, 0, 0, 0.06), 0 1px 3px rgba(0, 0, 0, 0.02);
    }

    [data-bs-theme="dark"] {
        --card-bg: #161b22;
        --input-bg: #0d1117;
        --input-border: rgba(255, 255, 255, 0.15);
        --input-focus-bg: #161b22;
        --card-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
    }

    .min-vh-80 {
        min-height: 80vh;
    }

    .apple-card {
        background-color: var(--card-bg) !important;
        border-radius: 22px !important;
        box-shadow: var(--card-shadow) !important;
        transition: background-color 0.25s ease, box-shadow 0.25s ease;
    }

    .form-control, .input-group-text {
        background-color: var(--input-bg) !important;
        border-color: var(--input-border) !important;
        color: var(--bs-body-color) !important;
        transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
        font-size: 0.95rem;
    }

        .form-control:focus {
            background-color: var(--input-focus-bg) !important;
            border-color: #0071e3 !important;
            box-shadow: 0 0 0 4px rgba(0, 113, 227, 0.2) !important;
            color: var(--bs-body-color) !important;
        }

    .input-group:focus-within .input-group-text {
        background-color: var(--input-focus-bg) !important;
        border-color: #0071e3 !important;
    }

    .apple-btn {
        background-color: #0071e3;
        border-color: #0071e3;
        border-radius: 12px !important;
        font-size: 0.95rem;
        transition: all 0.2s ease;
    }

        .apple-btn:hover {
            background-color: #0077ed;
            border-color: #0077ed;
            transform: scale(1.01);
        }

        .apple-btn:active {
            transform: scale(0.99);
        }
</style>