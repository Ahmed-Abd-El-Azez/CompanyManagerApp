@model EmployeeApp.Models.ViewModels.EmployeeViewModel

@{
    ViewData["Title"] = "Create Employee";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-success text-white p-3">
                    <h4 class="card-title mb-0 fs-5 fw-bold">
                        <i class="bi bi-person-plus-fill me-2"></i>Create New Employee
                    </h4>
                </div>

                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 mb-3 small" role="alert"></div>

                        <!-- Employee Name -->
                        <div class="form-floating mb-3">
                            <input asp-for="Name" class="form-control" placeholder="Employee Name" />
                            <label asp-for="Name"></label>
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <!-- Salary -->
                        <div class="form-floating mb-3">
                            <input asp-for="Salary" class="form-control" placeholder="Salary" type="number" step="0.01" />
                            <label asp-for="Salary"></label>
                            <span asp-validation-for="Salary" class="text-danger small"></span>
                        </div>

                        <!-- Department Selection -->
                        <div class="form-floating mb-3">
                            <select asp-for="DepartmentId" class="form-select" asp-items="ViewBag.Departments">
                                <option value="">-- Select Department --</option>
                            </select>
                            <label asp-for="DepartmentId">Department</label>
                            <span asp-validation-for="DepartmentId" class="text-danger small"></span>
                        </div>

                        <!-- Projects Multi-Select -->
                        <div class="mb-4">
                            <label class="form-label fw-semibold text-secondary mb-1">Assigned Projects</label>
                            <select id="projectsDropdown" name="selectedProjectIds" class="form-select" multiple="multiple">
                                @if (ViewBag.AllProjects is IEnumerable<EmployeeApp.Models.ViewModels.ProjectViewModel> projectsList && projectsList.Any())
                                {
                                    foreach (var proj in projectsList)
                                    {
                                        bool isSelected = Model?.SelectedProjectIds != null && Model.SelectedProjectIds.Contains(proj.ProjectId);
                                        if (isSelected)
                                        {
                                            <option value="@proj.ProjectId" selected="selected">@proj.ProjectName</option>
                                        }
                                        else
                                        {
                                            <option value="@proj.ProjectId">@proj.ProjectName</option>
                                        }
                                    }
                                }
                            </select>
                        </div>

                        <!-- Buttons -->
                        <div class="d-flex align-items-center justify-content-between pt-2">
                            <a asp-action="Index" class="btn btn-outline-secondary px-3">
                                <i class="bi bi-arrow-left me-1"></i>Back to List
                            </a>
                            <button type="submit" class="btn btn-success px-4 fw-semibold">
                                <i class="bi bi-check-circle me-1"></i>Create
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <!-- Select2 Library Styles & Scripts -->
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>
        $(document).ready(function() {
            $('#projectsDropdown').select2({
                placeholder: "-- Select Projects --",
                allowClear: true,
                width: '100%'
            });
        });
    </script>
}