@using Microsoft.AspNetCore.Authentication
<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EmployeeApp</title>

    <!-- Prevent FOUC (Flash of Unstyled Content) -->
    <script>
        (function() {
            const savedTheme = localStorage.getItem('theme');
            const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            const theme = savedTheme || (systemDark ? 'dark' : 'light');
            document.documentElement.setAttribute('data-bs-theme', theme);
        })();
    </script>

    <!-- Fonts & Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EmployeeApp.styles.css" asp-append-version="true" />

    <style>
        :root {
            --app-bg: #f5f5f7;
            --navbar-bg: rgba(255, 255, 255, 0.85);
            --card-bg: #ffffff;
            --border-color: rgba(0, 0, 0, 0.08);
            --user-chip-bg: #eef2ff;
            --user-chip-color: #3730a3;
        }

        [data-bs-theme="dark"] {
            --app-bg: #0d1117;
            --navbar-bg: rgba(13, 17, 23, 0.85);
            --card-bg: #161b22;
            --border-color: rgba(255, 255, 255, 0.12);
            --user-chip-bg: rgba(99, 102, 241, 0.2);
            --user-chip-color: #a5b4fc;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background-color: var(--app-bg);
            transition: background-color 0.25s ease, color 0.25s ease;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        .navbar {
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            background-color: var(--navbar-bg) !important;
            border-bottom: 1px solid var(--border-color) !important;
            transition: background-color 0.25s ease, border-color 0.25s ease;
        }

        .nav-link {
            font-weight: 500;
            padding: 0.4rem 0.85rem !important;
            border-radius: 980px;
            transition: all 0.15s ease-in-out;
        }

        .nav-link:hover, .nav-link:focus {
            background-color: rgba(13, 110, 253, 0.08);
        }

        .user-chip {
            background-color: var(--user-chip-bg);
            color: var(--user-chip-color);
            font-weight: 600;
            padding: 0.35rem 0.85rem;
            border-radius: 50rem;
            font-size: 0.85rem;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            max-width: 140px;
            min-width: 0;
        }

        .theme-toggle-btn {
            border: 1px solid var(--border-color);
            background: transparent;
            color: var(--bs-body-color);
            width: 38px;
            height: 38px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .theme-toggle-btn:hover {
            background-color: rgba(125, 125, 125, 0.15);
            transform: scale(1.05);
        }

        main {
            flex: 1;
        }

        footer {
            background-color: var(--card-bg);
            border-top: 1px solid var(--border-color) !important;
            transition: background-color 0.25s ease;
        }
    </style>
</head>
<body>
    <header class="sticky-top">
        <nav class="navbar navbar-expand-xl border-bottom shadow-sm py-2">
            <div class="container">
                <!-- Brand -->
                <a class="navbar-brand fw-bold text-primary d-flex align-items-center gap-2 flex-shrink-0" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-briefcase-fill"></i>
                    <span>EmployeeApp</span>
                </a>

                <!-- Mobile Toggle -->
                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent"
                        aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Nav Content -->
                <div class="collapse navbar-collapse" id="navbarContent">
                    <!-- Left Links -->
                    <ul class="navbar-nav me-auto mb-2 mb-xl-0 gap-1 pt-2 pt-xl-0">
                        <li class="nav-item">
                            <a class="nav-link d-flex align-items-center gap-1.5" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door"></i> Home
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link d-flex align-items-center gap-1.5" asp-area="" asp-controller="Employee" asp-action="Index">
                                <i class="bi bi-people"></i> Employees
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link d-flex align-items-center gap-1.5" asp-area="" asp-controller="Department" asp-action="Index">
                                <i class="bi bi-diagram-3"></i> Departments
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link d-flex align-items-center gap-1.5" asp-area="" asp-controller="Project" asp-action="Index">
                                <i class="bi bi-kanban"></i> Projects
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link d-flex align-items-center gap-1.5" asp-controller="Department" asp-action="TestAjax">
                                <i class="bi bi-search"></i> Search
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link d-flex align-items-center gap-1.5" asp-area="" asp-controller="Home" asp-action="Privacy">
                                <i class="bi bi-shield-check"></i> Privacy
                            </a>
                        </li>
                    </ul>

                    <!-- Right Controls (Theme Switcher + Auth) -->
                    <div class="d-flex align-items-center gap-2 pt-2 pt-xl-0 flex-shrink-0">
                        <!-- Theme Toggle Button -->
                        <button type="button" id="themeToggleBtn" class="theme-toggle-btn me-1 flex-shrink-0" aria-label="Toggle theme">
                            <i id="themeIcon" class="bi bi-moon-stars-fill"></i>
                        </button>

                        @{
                            var token = await Context.GetTokenAsync("access_token");
                            var isAuthenticated = User.Identity?.IsAuthenticated == true && !string.IsNullOrEmpty(token);
                        }

                        @if (isAuthenticated)
                        {
                            var rawName = User.Identity?.Name ?? "User";
                            var displayName = rawName.Contains("@") ? rawName.Split('@')[0] : rawName;

                            <div class="user-chip d-flex align-items-center gap-1.5" title="@User.Identity?.Name">
                                <i class="bi bi-person-circle flex-shrink-0"></i>
                                <span class="text-truncate">@displayName</span>
                            </div>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline m-0 flex-shrink-0">
                                <button type="submit" class="btn btn-outline-danger btn-sm d-flex align-items-center gap-1 rounded-pill px-3">
                                    <i class="bi bi-box-arrow-right"></i> Logout
                                </button>
                            </form>
                        }
                        else
                        {
                            <a class="btn btn-outline-primary btn-sm rounded-pill px-3" asp-controller="Account" asp-action="Login">
                                Log in
                            </a>
                            <a class="btn btn-primary btn-sm rounded-pill px-3 shadow-sm" asp-controller="Account" asp-action="Register">
                                Register
                            </a>
                        }
                    </div>
            </div>
        </nav>
    </header>

    <div class="container py-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="py-3 text-muted">
        <div class="container d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2">
            <div>
                &copy; 2026 - <span class="fw-semibold">EmployeeApp</span>
            </div>
            <div>
                <a class="text-decoration-none text-muted small" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy Policy</a>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- Theme Switcher Script -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const toggleBtn = document.getElementById('themeToggleBtn');
            const themeIcon = document.getElementById('themeIcon');
            const htmlElement = document.documentElement;

            const updateIcon = (theme) => {
                if (theme === 'dark') {
                    themeIcon.className = 'bi bi-sun-fill text-warning';
                } else {
                    themeIcon.className = 'bi bi-moon-stars-fill';
                }
            };

            // Initial icon update on load
            updateIcon(htmlElement.getAttribute('data-bs-theme'));

            toggleBtn.addEventListener('click', () => {
                const currentTheme = htmlElement.getAttribute('data-bs-theme');
                const newTheme = currentTheme === 'dark' ? 'light' : 'dark';

                htmlElement.setAttribute('data-bs-theme', newTheme);
                localStorage.setItem('theme', newTheme);
                updateIcon(newTheme);
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>