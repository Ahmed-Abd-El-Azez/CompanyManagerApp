@model EmployeeApp.Models.ViewModels.EmployeeViewModel

<div class="col-md-4 mb-4">
    <div class="card h-100 shadow-sm border-0 rounded-3">
        <div class="card-body">
            <h5 class="card-title fw-bold">@Model.Name</h5>
            <p class="card-text text-muted mb-1">
                <i class="bi bi-briefcase me-1"></i> Department: @(Model.DepartmentName ?? "N/A")
            </p>
            <p class="card-text text-success fw-semibold">
                <i class="bi bi-currency-dollar me-1"></i> Salary: @Model.Salary.ToString()
            </p>
        </div>
        <div class="card-footer bg-transparent border-0 d-flex justify-content-end gap-2 pb-3">
            @if (User.IsInRole("Admin"))
            {
                <a asp-action="Edit" asp-route-id="@Model.EmployeeId" class="btn btn-sm btn-outline-warning">
                    <i class="bi bi-pencil"></i> Edit
                </a>
            }

            <a asp-action="Details" asp-route-id="@Model.EmployeeId" class="btn btn-sm btn-outline-info">
                <i class="bi bi-info-circle"></i> Details
            </a>

            @if (User.IsInRole("Admin"))
            {
                <a asp-action="Delete" asp-route-id="@Model.EmployeeId" class="btn btn-sm btn-outline-danger">
                    <i class="bi bi-trash"></i> Delete
                </a>
            }
        </div>
    </div>
</div>